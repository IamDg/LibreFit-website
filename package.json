{
  "name": "librefit-website",
  "version": "1.0.0",
  "description": "Official LibreFit website",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:templates-css",
    "build:site-css": "astro build",
    "build:templates-css": "tailwindcss -i templates/app.css -o public/styles.css --minify",
    "preview": "astro preview",
    "preview:cf": "astro build && wrangler pages dev dist",
    "astro": "astro",
    "check:functions": "tsc -p functions --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LibreFitOrg/LibreFit-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/LibreFitOrg/LibreFit-website/issues"
  },
  "homepage": "https://github.com/LibreFitOrg/LibreFit-website#readme",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-paginate-rest": "^15.0.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "astro": "^7.2.10",
    "drizzle-orm": "^0.45.1",
    "openpgp": "^6.3.1",
    "postgres": "^3.4.9",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
